# 发布 / 更新通道参数。脚本一律 source 本文件，不硬编码。
# 分工：Config/naming.env 管「名字」，本文件管「通道与策略」。
#
# 本文件是 shell 可 source 的 KEY=VALUE 格式：值不要带空格，列表用双引号。

# MARK: - feed

# feed 托管在 tag 固定为 feed 的独立 Release 上，URL 与版本号无关：
#   https://github.com/<owner>/<repo>/releases/download/feed/feed-stable.json
# 换版本不需要改客户端，也不需要 CI：重新上传同名资产即可（gh release upload --clobber）。
FEED_TAG=feed
FEED_SCHEMA=1
FEED_STABLE_ASSET=feed-stable.json
FEED_BETA_ASSET=feed-beta.json
# alpha 只在开发机内部使用，永不生成公开 feed（脚本会拒绝发布 alpha）。
FEED_ALPHA_ASSET=feed-alpha.json

# MARK: - 通道可见性

# 每个公开通道能看到哪些 stage。stable 只认 stable；beta 额外能看到 beta/rc。
# 双重防护：生成 feed 时过滤一次，客户端取条目时再过滤一次。
CHANNEL_STABLE_SEES="stable"
CHANNEL_BETA_SEES="stable beta rc"

# MARK: - 检查节奏（客户端行为；脚本只做打印与文档对齐）

UPDATE_CHECK_LAUNCH_DELAY_SECONDS=10
UPDATE_CHECK_INTERVAL_HOURS=24
UPDATE_CHECK_JITTER_PERCENT=15
# 连续失败后的退避序列（小时）；用尽后保持最后一档。
UPDATE_CHECK_BACKOFF_HOURS="24 48 72"

# MARK: - 资产与下载

# 更新包只发 zip（ditto 保留 bundle 元数据，无需挂载）；dmg 仅用于首次安装，不进 feed。
UPDATE_ASSET_FORMAT=zip
MIN_MACOS=13.0
# 单个镜像的单次下载超时（秒）。镜像多时总耗时上限 = 启用镜像数 × 本值。
DOWNLOAD_TIMEOUT_SECONDS=20
