# 命名的唯一来源。改这个文件，然后跑 `Scripts/naming.sh --emit-swift`。
#
# 这里只放「会出现在用户视野或分发链路里的名字」：
#   显示名 / .app 名 / 可执行名 / bundle id / GitHub 仓库 / Release 资产模板 / 更新源。
# 代码里不要硬编码这些值，一律通过生成的 `Sources/Brimio/Generated/Naming.swift`
# 或打包脚本 source 本文件来取。
#
# 注意：本文件是 shell 可 source 的 KEY=VALUE 格式，值不要带空格与引号内的 $。

# 产品显示名（Finder / 设置页 / 关于面板里看到的）
APP_DISPLAY_NAME=Brimio

# .app 包名与可执行文件名（也用于 Release 资产前缀的主体）
APP_BUNDLE_NAME=Brimio

# GitHub 仓库名（全小写，与远端仓库一致）
APP_REPO=brimio

# bundle id：反向域名，个人账号下用 io.github.<owner>.<repo>
APP_BUNDLE_ID=io.github.yunyu697.brimio

# 设置窗口标题（播放器兼容页；与产品名无关，改名时不需要动）
SETTINGS_WINDOW_TITLE=播放器兼容

# Release 资产命名模板。{tag} 会替换成含 v 前缀的 tag（如 v0.1.0-alpha1），
# 例：brimio-v0.1.0-alpha1.zip。打包脚本与更新检查器都必须用这一个模板。
RELEASE_ASSET_TEMPLATE={repo}-{tag}.zip

# 更新检查器的数据源（GitHub Releases）
UPDATE_OWNER=yunyu697
UPDATE_REPO=brimio
