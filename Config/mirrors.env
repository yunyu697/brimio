# 内置下载镜像清单。顺序 = 失败切换顺序，脚本按 MIRROR_n 递增依次尝试。
#
# 模板占位符：{owner} {repo} {tag} {asset}
#   {owner}/{repo} 取自 Config/naming.env 的 UPDATE_OWNER / UPDATE_REPO
#   {tag} 是含 v 前缀的 tag，{asset} 是 Release 资产名
#
# PUBLIC_ONLY=1：只能转发公开仓库的资产。私有仓库下必然 401/404，脚本会跳过并记录原因。
# ENABLED=0：占位未开通（需要账号 / 建仓 / 付费），脚本不尝试；开通步骤见 Release/RELEASE-PLAN.md。
#
# 注意：镜像只做「传输」，不参与信任判断。每个候选都必须通过 feed 里的 sha256 才算成功；
# 任何镜像返回的内容只要哈希不符就丢弃并换下一个，不存在「跳过校验」的分支。

MIRROR_COUNT=5

# 1) 权威源：GitHub Releases 直连（302 到 objects.githubusercontent.com）
#    私有仓库下仍然可用，前提是带凭据（gh CLI 或 GH_TOKEN），这也是当前唯一可用的通道。
MIRROR_1_ID=github-direct
MIRROR_1_TEMPLATE=https://github.com/{owner}/{repo}/releases/download/{tag}/{asset}
MIRROR_1_PUBLIC_ONLY=0
MIRROR_1_ENABLED=1

# 2) ghfast.top（gh-proxy 系公共反代）
#    本机实测 200，TLS 握手约 3.0s；无 SLA，可能限速或对私有资产返回 404。
MIRROR_2_ID=ghfast
MIRROR_2_TEMPLATE=https://ghfast.top/https://github.com/{owner}/{repo}/releases/download/{tag}/{asset}
MIRROR_2_PUBLIC_ONLY=1
MIRROR_2_ENABLED=1

# 3) ghproxy.net（同类公共反代）
#    本机实测 200，TLS 握手约 3.05s；与 2) 同一类服务，互为备份而非叠加信任。
MIRROR_3_ID=ghproxy-net
MIRROR_3_TEMPLATE=https://ghproxy.net/https://github.com/{owner}/{repo}/releases/download/{tag}/{asset}
MIRROR_3_PUBLIC_ONLY=1
MIRROR_3_ENABLED=1

# 4) Gitee 自建镜像仓（国内可达性最好的一档，但要人工同步资产）
#    开通前置：Gitee 账号 + 建仓 + 每个版本手工/脚本同步资产（需用户本人执行）。
MIRROR_4_ID=gitee
MIRROR_4_TEMPLATE=https://gitee.com/REPLACE_ME/brimio/releases/download/{tag}/{asset}
MIRROR_4_PUBLIC_ONLY=1
MIRROR_4_ENABLED=0

# 5) 自建对象存储 / CDN（R2、OSS、COS 等）
#    开通前置：账号 + 计费 + 上传凭据；优点是长期稳定、可自定义回源与缓存策略。
MIRROR_5_ID=object-storage
MIRROR_5_TEMPLATE=https://REPLACE_ME.example.com/brimio/releases/{tag}/{asset}
MIRROR_5_PUBLIC_ONLY=1
MIRROR_5_ENABLED=0
